# ── Django core ──────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-50-char-random-string
DJANGO_ENVIRONMENT=prod
DJANGO_SETTINGS_MODULE=arshaad.settings.prod

# ── Database (Neon PostgreSQL — already set up) ───────────────
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your-neon-db-password
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432

# ── CORS (comma-separated list of allowed frontend origins) ───
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://arshaad.com

# ── Allowed hosts (comma-separated) ──────────────────────────
ALLOWED_HOSTS=your-app.railway.app,arshaad.com

# ── Email (optional — leave blank to disable email sending) ───
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@arshaad.com

# ── OAuth (optional — configure in Django admin instead) ──────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
